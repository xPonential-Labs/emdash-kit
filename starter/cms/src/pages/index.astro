---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import Sections from "emdash-kit/sections/Sections.astro";

// The home page is the "home" entry in Pages, so editors change it like any other page.
const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title={page?.data.title} content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}>
	{page ? <Sections value={page.data.layout} /> : <p class="placeholder">No home page yet.</p>}
</Base>
