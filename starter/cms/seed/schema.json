{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "{{DOMAIN}}",
		"description": "Placeholder site",
		"author": "xPonential Labs"
	},
	"collections": [
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "layout",
					"label": "Page sections",
					"type": "blocks",
					"validation": {
						"allowedTypes": [
							"hero",
							"text",
							"image_text",
							"cards",
							"steps",
							"gallery",
							"quote",
							"faq",
							"cta_band",
							"links"
						],
						"maxItems": 30
					}
				}
			]
		},
		{
			"slug": "look",
			"label": "Look",
			"labelSingular": "Look",
			"supports": [
				"drafts",
				"revisions"
			],
			"fields": [
				{
					"slug": "style",
					"label": "Look of the site",
					"type": "select",
					"required": true,
					"options": [
						"warm",
						"bold",
						"quiet",
						"playful",
						"editorial",
						"dark"
					],
					"validation": {
						"options": [
							"warm",
							"bold",
							"quiet",
							"playful",
							"editorial",
							"dark"
						]
					}
				}
			]
		}
	],
	"widgetAreas": [],
	"menus": []
}
